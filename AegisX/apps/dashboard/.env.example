# -------------------------------------------------------------
# AegisX Web Dashboard Configuration
# -------------------------------------------------------------

# API URL for the AegisX bot backend REST API (default port: 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Shared API Key for authentication (must match DASHBOARD_API_KEY in bot .env)
NEXT_PUBLIC_DASHBOARD_API_KEY=aegisx_secure_api_key_2026

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=aegisx_nextauth_default_secret_string_2026_change_me

# Discord OAuth2 Configuration (from https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_discord_bot_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth2_client_secret

# Admin User IDs (comma separated)
NEXT_PUBLIC_ADMIN_IDS=your_discord_user_id

# Customizable Brand / Bot name shown across the dashboard
NEXT_PUBLIC_BRAND_NAME="AegisX"
NEXT_PUBLIC_BRAND_NAME_WORD="AX"